# ---------------------------------------------------------------------------
# chopcam AGGREGATOR configuration  (one per install)
#
# Copy to /etc/chopcam-agg.conf and edit. Same format as the node config:
#   KEY="value"   -- no spaces around '=', always quote values.
# Trailing comments after a value are fine.
#
# This is the aggregator half. The capture Pis have their own
# /etc/chopcam.conf -- see chopcam.conf.example at the repo root.
# ---------------------------------------------------------------------------

# Which install this aggregator serves. Must match SITE on its capture nodes,
# so clip names arriving here line up with the wall.
SITE=""

# The capture nodes this aggregator watches, as "name=address" pairs separated
# by spaces. The name is the node's NODE_NAME (not SITE-NODE_NAME).
#
# The number of nodes varies per install -- add or remove entries, nothing else
# changes.
#
#   NODES="uw1=192.168.0.101 uw2=192.168.0.102 uw3=192.168.0.103 uw4=192.168.0.104"
NODES=""

# HTTP port each capture node serves its preview and health on. This is
# LIVE_PORT in the node config; they must match.
NODE_PORT="8080"

# How often the aggregator polls each node's /healthz, in seconds. This is
# cheap (a small JSON fetch) and is what makes a dead node visible on the wall
# instead of just a frozen tile.
POLL_SECONDS="5"

# Port the wall is served on. Open http://<aggregator>:8090/ on the monitor.
WALL_PORT="8090"
WALL_HOST="0.0.0.0"

# Where the nodes deliver clips. This must match AGG_DIR in each node's config,
# and the account the nodes ssh in as must be able to write here.
INCOMING_DIR="/srv/chopcam/incoming"

# Newest N clips listed at /clips when nothing asks for more. The player's
# per-camera clip list asks for more explicitly, so this is only a default.
CLIP_LIST_LIMIT="50"

# --- retention --------------------------------------------------------------
# How many days of clips to keep. THIS IS THE ONLY SETTING YOU NEED TO CHANGE
# to keep footage for longer or shorter.
#
# The purge timer re-reads this file on every run, so editing the number takes
# effect on the next pass -- no restart, no service to touch. Check what it
# would do first, without deleting anything:
#     python3 /opt/chopcam-agg/purge.py --dry-run
#
# Age is taken from the timestamp in each clip's filename, not the file's
# mtime, so a node delivering a backlog after being offline does not reset the
# clock on old footage.
#
# "Keep this clip" in the player moves a clip to INCOMING_DIR/keep/, which the
# purge never touches -- not on age, and not when the disk fills. That is the
# way to hold on to a clip that matters for longer than this window, and it
# needs no config change at all.
RETENTION_DAYS="7"

# Emergency guard. If the filesystem reaches this percentage, oldest clips are
# deleted first regardless of age, so a retention window that turns out to be
# too long for the disk cannot fill it. Values below 50 are clamped up: a typo
# here would otherwise empty the archive on a healthy disk.
#
# Kept clips are exempt from this too. If enough of them accumulate that there
# is nothing left to free, the purge says so in its log -- check it with
# "journalctl -u chopcam-purge" if the disk is filling.
DISK_PCT_LIMIT="85"

# --- playback ---------------------------------------------------------------
# How much slower the "Download slow motion" button makes a clip. 4 turns
# 120 fps into 30 fps, so it plays at quarter speed in any player with every
# frame intact. The file is remuxed, never re-encoded.
SLOWMO_FACTOR="4"

# A chop that fired but has not arrived after this many minutes is shown as
# "delayed" and the node counts as degraded. The node transcodes before
# shipping, which takes minutes, so this needs headroom above that -- but it
# is what surfaces a genuinely stuck pipeline instead of footage quietly never
# appearing.
STUCK_MINUTES="30"

# --- chop log ---------------------------------------------------------------
# Every trigger every node reports is recorded here, whether a clip came of it
# or not, and it outlives both the nodes' own memory and the footage itself.
# Read it at http://<aggregator>:8090/log .
#
# Defaults to choplog.jsonl inside INCOMING_DIR, which is already writable by
# the wall service; set this only to put it somewhere else (and then add that
# directory to ReadWritePaths in chopcam-wall.service).
#CHOPLOG="/srv/chopcam/incoming/choplog.jsonl"

# How many chops to keep in the log. Each is a couple of hundred bytes, so the
# default is well under a megabyte. The oldest are dropped past this.
CHOPLOG_MAX="5000"

# How often to re-read a node's trigger list even when its trigger count has
# not moved, in seconds. A chop goes "recording" to "recorded" a post-roll
# after it fires without the count changing, and this is what notices.
CHOPLOG_SYNC_SECONDS="30"
